{
  "version": 1,
  "lessons": [
    {
      "id": "l1",
      "fr": "Bonjour !",
      "title": {
        "ja": "あいさつ",
        "en": "Greetings"
      },
      "intro": {
        "ja": "毎日使うあいさつとお礼の言葉。フランスではお店に入るとき « Bonjour » と言うのがマナーです。",
        "en": "Everyday hellos, goodbyes and thank-yous. In France it's polite to say « Bonjour » when you walk into a shop."
      },
      "phrases": [
        {
          "id": "l1-01",
          "fr": "Bonjour",
          "ja": "こんにちは／おはようございます",
          "en": "Hello / Good morning",
          "kana": "ボンジュール"
        },
        {
          "id": "l1-02",
          "fr": "Bonsoir",
          "ja": "こんばんは",
          "en": "Good evening",
          "kana": "ボンソワール"
        },
        {
          "id": "l1-03",
          "fr": "Salut",
          "ja": "やあ／じゃあね（くだけた言い方）",
          "en": "Hi / Bye (casual)",
          "kana": "サリュ",
          "note": {
            "ja": "友だち同士で使います。店員さんや初対面の人には Bonjour を。",
            "en": "For friends. Use Bonjour with shop staff and people you don't know."
          }
        },
        {
          "id": "l1-04",
          "fr": "Merci",
          "ja": "ありがとう",
          "en": "Thank you",
          "kana": "メルスィ"
        },
        {
          "id": "l1-05",
          "fr": "Merci beaucoup",
          "ja": "どうもありがとうございます",
          "en": "Thank you very much",
          "kana": "メルスィ ボクー"
        },
        {
          "id": "l1-06",
          "fr": "De rien",
          "ja": "どういたしまして",
          "en": "You're welcome",
          "kana": "ドゥ リヤン"
        },
        {
          "id": "l1-07",
          "fr": "S'il vous plaît",
          "ja": "お願いします",
          "en": "Please",
          "kana": "スィル ヴ プレ"
        },
        {
          "id": "l1-08",
          "fr": "Excusez-moi",
          "ja": "すみません（呼びかけ）",
          "en": "Excuse me",
          "kana": "エクスキュゼ ムワ"
        },
        {
          "id": "l1-09",
          "fr": "Pardon",
          "ja": "ごめんなさい",
          "en": "Sorry",
          "kana": "パルドン"
        },
        {
          "id": "l1-10",
          "fr": "Au revoir",
          "ja": "さようなら",
          "en": "Goodbye",
          "kana": "オ ルヴォワール"
        },
        {
          "id": "l1-11",
          "fr": "Bonne journée !",
          "ja": "よい一日を！",
          "en": "Have a nice day!",
          "kana": "ボヌ ジュルネ"
        }
      ],
      "tips": [
        {
          "ja": "語末の子音字はたいてい読みません。beaucoup の p、plaît の t、vous の s は発音しません。",
          "en": "Final consonants are usually silent: the p in beaucoup, the t in plaît, the s in vous."
        },
        {
          "ja": "R はのどの奥で軽くこする音。日本語のラ行（舌先で弾く音）とは違い、軽いうがいに近い音です。Bonjour と Au revoir で練習しましょう。",
          "en": "French R is made at the back of the throat, close to a light gargle, not the Japanese ラ行 tongue-tap. Practise with Bonjour and Au revoir."
        },
        {
          "ja": "カタカナは目安です。かならず音声を聞いて、まねして言いましょう。",
          "en": "The katakana is only a rough guide. Always listen to the audio and copy it."
        }
      ],
      "dialogue": {
        "title": {
          "ja": "パン屋で",
          "en": "At the bakery"
        },
        "lines": [
          {
            "id": "l1-d1",
            "who": "Paul",
            "v": "m",
            "fr": "Bonjour, madame !",
            "ja": "こんにちは！",
            "en": "Hello, ma'am!"
          },
          {
            "id": "l1-d2",
            "who": "Claire",
            "v": "f",
            "fr": "Bonjour, monsieur.",
            "ja": "こんにちは。",
            "en": "Hello, sir."
          },
          {
            "id": "l1-d3",
            "who": "Paul",
            "v": "m",
            "fr": "Un croissant, s'il vous plaît.",
            "ja": "クロワッサンを一つお願いします。",
            "en": "A croissant, please."
          },
          {
            "id": "l1-d4",
            "who": "Claire",
            "v": "f",
            "fr": "Voilà. Un euro, s'il vous plaît.",
            "ja": "はい、どうぞ。1ユーロです。",
            "en": "Here you are. One euro, please."
          },
          {
            "id": "l1-d5",
            "who": "Paul",
            "v": "m",
            "fr": "Merci beaucoup ! Au revoir !",
            "ja": "どうもありがとう！さようなら！",
            "en": "Thank you very much! Goodbye!"
          },
          {
            "id": "l1-d6",
            "who": "Claire",
            "v": "f",
            "fr": "De rien. Bonne journée !",
            "ja": "どういたしまして。よい一日を！",
            "en": "You're welcome. Have a nice day!"
          }
        ],
        "questions": [
          {
            "q": {
              "ja": "ポールは何を買いましたか？",
              "en": "What did Paul buy?"
            },
            "options": [
              {
                "ja": "クロワッサン",
                "en": "A croissant"
              },
              {
                "ja": "コーヒー",
                "en": "A coffee"
              },
              {
                "ja": "バゲット",
                "en": "A baguette"
              },
              {
                "ja": "水",
                "en": "Water"
              }
            ],
            "answer": 0
          },
          {
            "q": {
              "ja": "いくらでしたか？",
              "en": "How much did it cost?"
            },
            "options": [
              {
                "ja": "1ユーロ",
                "en": "One euro"
              },
              {
                "ja": "2ユーロ",
                "en": "Two euros"
              },
              {
                "ja": "10ユーロ",
                "en": "Ten euros"
              },
              {
                "ja": "無料",
                "en": "Free"
              }
            ],
            "answer": 0
          }
        ]
      }
    },
    {
      "id": "l2",
      "fr": "Enchanté",
      "title": {
        "ja": "自己紹介",
        "en": "Introducing yourself"
      },
      "intro": {
        "ja": "名前、出身、住んでいる場所を言ってみましょう。",
        "en": "Say your name, where you're from and where you live."
      },
      "phrases": [
        {
          "id": "l2-01",
          "fr": "Je m'appelle Yuki.",
          "ja": "私の名前はユキです。",
          "en": "My name is Yuki.",
          "kana": "ジュ マペル ユキ",
          "note": {
            "ja": "Yuki のところに自分の名前を入れましょう。",
            "en": "Swap in your own name."
          }
        },
        {
          "id": "l2-02",
          "fr": "Comment vous appelez-vous ?",
          "ja": "お名前は何ですか？（ていねい）",
          "en": "What's your name? (polite)",
          "kana": "コマン ヴ ザプレ ヴ"
        },
        {
          "id": "l2-03",
          "fr": "Enchanté.",
          "ja": "はじめまして。",
          "en": "Nice to meet you.",
          "kana": "アンシャンテ",
          "alt": [
            "Enchantée."
          ],
          "note": {
            "ja": "女性が書くときは Enchantée。発音は同じです。",
            "en": "Women write Enchantée. It sounds the same."
          }
        },
        {
          "id": "l2-04",
          "fr": "Je suis japonais.",
          "ja": "私は日本人です。（男性）",
          "en": "I'm Japanese. (man)",
          "kana": "ジュ スュイ ジャポネ",
          "v": "m"
        },
        {
          "id": "l2-05",
          "fr": "Je suis japonaise.",
          "ja": "私は日本人です。（女性）",
          "en": "I'm Japanese. (woman)",
          "kana": "ジュ スュイ ジャポネーズ"
        },
        {
          "id": "l2-06",
          "fr": "J'habite à Tokyo.",
          "ja": "東京に住んでいます。",
          "en": "I live in Tokyo.",
          "kana": "ジャビット ア トーキョー"
        },
        {
          "id": "l2-07",
          "fr": "J'apprends le français.",
          "ja": "フランス語を勉強しています。",
          "en": "I'm learning French.",
          "kana": "ジャプラン ル フランセ"
        },
        {
          "id": "l2-08",
          "fr": "Comment allez-vous ?",
          "ja": "お元気ですか？（ていねい）",
          "en": "How are you? (polite)",
          "kana": "コマン タレ ヴ"
        },
        {
          "id": "l2-09",
          "fr": "Ça va ?",
          "ja": "元気？",
          "en": "How's it going?",
          "kana": "サ ヴァ"
        },
        {
          "id": "l2-10",
          "fr": "Ça va bien, merci.",
          "ja": "元気です、ありがとう。",
          "en": "I'm fine, thanks.",
          "kana": "サ ヴァ ビヤン メルスィ"
        },
        {
          "id": "l2-11",
          "fr": "Et vous ?",
          "ja": "あなたは？",
          "en": "And you?",
          "kana": "エ ヴ"
        }
      ],
      "tips": [
        {
          "ja": "リエゾン：vous appelez は「ヴ ザプレ」。ふだん読まない語末の s が、次の母音とつながって［z］の音になります。",
          "en": "Liaison: vous appelez sounds like 'voo za-play'. The normally silent s joins the next vowel as a z sound."
        },
        {
          "ja": "h は発音しません。J'habite は「ジャビット」。",
          "en": "H is always silent: J'habite sounds like 'zha-beet'."
        },
        {
          "ja": "vous は初対面の人や目上の人に、tu は友だちや家族に使います。まずは vous から覚えましょう。",
          "en": "Use vous with strangers and anyone senior; tu with friends and family. Start with vous."
        },
        {
          "ja": "japonais／japonaise のように男性形と女性形があります。女性形は最後の s を「ズ」と読みます。",
          "en": "Many words have masculine and feminine forms. In japonaise the s is pronounced (z); in japonais it's silent."
        }
      ],
