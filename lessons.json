    {
      "id": "l3",
      "fr": "Un, deux, trois",
      "title": {
        "ja": "数字 1〜10",
        "en": "Numbers 1–10"
      },
      "intro": {
        "ja": "買い物や値段で必ず使う1から10までの数字。",
        "en": "One to ten: the numbers you need for shopping and prices."
      },
      "phrases": [
        {
          "id": "l3-01",
          "fr": "un",
          "ja": "1（いち）",
          "en": "1 (one)",
          "kana": "アン"
        },
        {
          "id": "l3-02",
          "fr": "deux",
          "ja": "2（に）",
          "en": "2 (two)",
          "kana": "ドゥ"
        },
        {
          "id": "l3-03",
          "fr": "trois",
          "ja": "3（さん）",
          "en": "3 (three)",
          "kana": "トロワ"
        },
        {
          "id": "l3-04",
          "fr": "quatre",
          "ja": "4（よん）",
          "en": "4 (four)",
          "kana": "カトル"
        },
        {
          "id": "l3-05",
          "fr": "cinq",
          "ja": "5（ご）",
          "en": "5 (five)",
          "kana": "サンク"
        },
        {
          "id": "l3-06",
          "fr": "six",
          "ja": "6（ろく）",
          "en": "6 (six)",
          "kana": "スィス"
        },
        {
          "id": "l3-07",
          "fr": "sept",
          "ja": "7（なな）",
          "en": "7 (seven)",
          "kana": "セット"
        },
        {
          "id": "l3-08",
          "fr": "huit",
          "ja": "8（はち）",
          "en": "8 (eight)",
          "kana": "ユイット"
        },
        {
          "id": "l3-09",
          "fr": "neuf",
          "ja": "9（きゅう）",
          "en": "9 (nine)",
          "kana": "ヌフ"
        },
        {
          "id": "l3-10",
          "fr": "dix",
          "ja": "10（じゅう）",
          "en": "10 (ten)",
          "kana": "ディス"
        }
      ],
      "tips": [
        {
          "ja": "un、cinq の「アン」「サン」は鼻母音。鼻に息を抜きながら言い、最後に舌を上につけません。",
          "en": "un and cinq use nasal vowels: let air through your nose and don't finish with your tongue touching the roof of your mouth."
        },
        {
          "ja": "six、dix は単独では「スィス」「ディス」。後ろに名詞が来ると音が変わります（six euros＝スィ ズーロ）。まずは単独の形で覚えましょう。",
          "en": "On their own, six and dix end in an s sound. Before a noun the sound changes (six euros = 'see zeu-ro'). Learn them alone first."
        },
        {
          "ja": "huit の h は読みません。「ユイット」。",
          "en": "The h in huit is silent."
        },
        {
          "ja": "un は男性名詞に、une は女性名詞に使います：un croissant、une baguette。",
          "en": "Use un with masculine nouns and une with feminine ones: un croissant, une baguette."
        }
      ],
